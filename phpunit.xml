<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            ONE VARIABLE, AND IT IS THE ONE THAT PICKS THE FILE THE REST LIVE IN.
            Laravel loads `.env.testing` INSTEAD OF `.env` when APP_ENV is
            already set at boot, so this line is what makes the suite hermetic;
            every other value it needs is in `.env.testing`, which is committed.

            THIS LIST USED TO BE A DOZEN ENTRIES LONG, and that was the bug.
            PHPUnit sets `<env>` before Dotenv runs and Dotenv is immutable, so
            these always won — while everything NOT listed here fell through to
            whatever `.env` sat next to the checkout. On production that is
            `ORBIT_PRICE_PROVIDER=travelpayouts`, i.e. `php artisan test` made
            real, metered API calls. Two places for one truth, and the one that
            won was the shorter list. Add new values to `.env.testing`.
        -->
        <env name="APP_ENV" value="testing"/>
    </php>
</phpunit>
