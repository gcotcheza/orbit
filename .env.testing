# =============================================================================
# Orbit — the environment the test suite runs in
# =============================================================================
# COMMITTED ON PURPOSE, and the only .env in this repository that is. Laravel
# loads `.env.<APP_ENV>` INSTEAD OF `.env` when APP_ENV is already set before
# the framework boots, and phpunit.xml sets exactly that one variable — so this
# file is what the suite sees, on any box, whatever the checkout's own `.env`
# happens to say.
#
# WHY IT HAD TO EXIST. Dotenv is immutable: a value already in the environment
# wins, and everything the suite did not pin fell through to the DEPLOYED `.env`
# next to it. On the production checkout that meant `ORBIT_PRICE_PROVIDER=
# travelpayouts` — so `php artisan test` resolved the REAL fare adapter and made
# REAL, metered API calls while proving the app worked. A test suite whose
# result depends on which box it runs on is not a gate.
#
# NOTHING SECRET IS IN HERE and nothing can be: every credential is either empty
# or a throwaway, the database is an in-memory SQLite file that never touches
# disk, and the mailer collects into an array. The APP_KEY below is a real key
# in the sense that it decrypts nothing — it was generated for this file, has
# never encrypted a session, and is published so the suite does not need a
# `key:generate` before it can boot.
#
# ⚠ THE VALUES LIVE HERE AND NOWHERE ELSE. phpunit.xml used to pin a dozen of
#   them as `<env>` entries, which is a second place for the truth to live and
#   the one that silently wins (PHPUnit sets its `<env>` before Dotenv runs).
#   Add a variable the suite needs to THIS file.
# =============================================================================

APP_NAME=Orbit
APP_ENV=testing
APP_KEY=base64:DYsRhoZTof2q+STM/lci8vRXC0wGsdSb3FCRJ+Wzdwc=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The owner's clock, and the suite's. Every date assertion in tests/ is written
# against Europe/Amsterdam, so this is not a detail that may drift with the box.
ORBIT_TIMEZONE=Europe/Amsterdam

# --- The fare providers -------------------------------------------------------
# BOTH FAKE, AND THIS IS THE POINT OF THE FILE. The fakes are deterministic, so
# a test can assert a real number; the real adapters are metered and slow, and
# tests/TestCase's Http::preventStrayRequests() now turns any call one of them
# would make into a failure rather than a charge. Two doors, both shut.
#
# The tests that DO exercise the real adapters name them through config() for
# the length of one test (tests/Feature/TravelpayoutsPollTest,
# tests/Feature/SelfStatsProviderTest) and fake the HTTP under them.
ORBIT_PRICE_PROVIDER=fake
ORBIT_STATS_PROVIDER=fake
ORBIT_RETURNS_PROVIDER=fake
ORBIT_SWEEP_PROVIDER=fake

# THE REGEX PARSER, EXPLICITLY. config/orbit.php picks `anthropic` the moment an
# ANTHROPIC_API_KEY is present, and the SDK talks through its own Guzzle client
# rather than Laravel's — so a leaked key would have made real, billed model
# calls from tests/Feature/RulesApiTest that no HTTP fake could intercept.
ORBIT_NLP_PARSER=regex
ANTHROPIC_API_KEY=

# Empty, so that "selecting travelpayouts without a token refuses to resolve"
# tests the thing it says it tests rather than the box it runs on.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
SERPAPI_KEY=

APP_MAINTENANCE_DRIVER=file

# FOUR ROUNDS, NOT TWELVE. Hashing is the single most expensive thing the suite
# does — every factory-made user pays for it — and nothing here is protecting a
# password from anybody.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# IN MEMORY, so a run leaves nothing behind and two runs cannot see each other's
# rows. `DB_URL` is pinned empty because config/database.php prefers it over the
# host/port fields when it is set, and a deployed .env has one.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_URL=

# ARRAYS AND SYNC, ALL FOUR. Nothing in the suite may reach for redis, a queue
# worker or a session table: a test that passes only when a daemon happens to be
# running is a test that fails on somebody else's laptop for no reason.
SESSION_DRIVER=array
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# `array` and not `log`: Mail::fake() is what most tests use, and the ones that
# do not assert against the collected messages rather than parsing a logfile.
MAIL_MAILER=array
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS="flights@ghiecode.io"
MAIL_FROM_NAME="Orbit"

# The seeder's account. The same defaults config/orbit.php carries, written out
# so the suite's idea of "the owner" cannot change with a deploy.
SEED_USER_EMAIL=ghie.cotcheza@gmail.com
SEED_USER_NAME=Ghie
SEED_USER_PASSWORD=

# Empty means deny, which is what the suite asserts about the dashboard gate.
HORIZON_DASHBOARD_TOKEN=

# The three telemetry packages, off. They subscribe to events and open their own
# connections; none of it is under test and all of it costs time.
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
