# =============================================================================
# Orbit — static analysis (PHPStan + Larastan)
# =============================================================================
# Run it the way the gate does:
#
#   scripts/check.sh                   # pint + phpstan + eslint + phpunit
#   docker compose exec -T app vendor/bin/phpstan analyse --memory-limit=512M
#
# WHY LARASTAN AND NOT PLAIN PHPSTAN
# Eloquent is built out of __call, __get and static proxies, so to plain PHPStan
# `Route::query()->where(...)->first()` is a call on a class that has no such
# method returning something it cannot name. Larastan is the PHPStan extension
# that teaches it the framework: model properties from the migrations/casts,
# builder chains, facades, container binds. Without it every model line in this
# app is a false positive, and a check that cries wolf is a check that gets
# switched off.
#
# NO BASELINE, AND THAT IS THE POINT
# health-tracker's copy of this file includes a `phpstan-baseline.neon` — an
# inventory of the findings that already existed the day analysis was switched
# on there. Orbit has no such day: the analysis is on before the first domain
# class is written, so there is nothing to inventory and a baseline would only
# ever be a place for new debt to hide. Keep it absent. If a finding is wrong,
# ignore it here with a reason next to it; if it is right, fix the code.
# =============================================================================

includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 8 is the highest level that is about CORRECTNESS rather than about
    # annotation completeness: it checks nullability on top of levels 0-7's
    # unknown methods, wrong argument types, dead conditions and bad returns.
    # Level 9 ("no mixed") and 10 are largely a docblock-writing exercise, and
    # on a codebase with a pure-PHP domain core the real findings are the ones
    # worth keeping visible.
    level: 8

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
        - tests

    excludePaths:
        analyseAndScan:
            # Generated by `package:discover` at install time; not source.
            - bootstrap/cache

    # ONE PROCESS, DELIBERATELY.
    # PHPStan parallelises by forking a worker per core, and each worker boots
    # the whole framework through Larastan. This box runs five other app stacks
    # beside this one, so four workers at ~250 MB each are how an analysis run
    # starts reporting a different number of errors every time — the workers die
    # and PHPStan reports what the survivors found. A single process is slower
    # and gives the same answer twice, which is the only kind of answer a gate
    # can be built on.
    parallel:
        maximumNumberOfProcesses: 1

    # STUBS: corrections to third-party PHPDoc, which is the mechanism PHPStan
    # itself points at for this. Each file says what it is fixing and why —
    # these are not silencers, they are types the vendor got wrong and that this
    # codebase would otherwise have to work around at every call site.
    stubFiles:
        - phpstan/stubs/Seeder.stub

    # Larastan reads the model's $casts, $fillable and the migrations to know
    # what `$fare->observed_at` is. Left on (the default): Orbit's models lean on
    # decimal casts for money and immutable_datetime for observation times, which
    # is exactly where a wrong assumption costs an afternoon.
    checkModelProperties: true
