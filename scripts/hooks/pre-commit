#!/usr/bin/env bash
# Usage: git runs this per commit; scripts/install-hooks.sh arms it. Bypass:
# git commit --no-verify. Why it must be a superset: docs/DECISIONS.md.
set -uo pipefail

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
    printf 'pre-commit: needs bash 4 or newer; refusing rather than half-checking.\n' >&2
    exit 1
fi

for tool in git awk grep sed cut; do
    command -v "$tool" >/dev/null 2>&1 && continue
    printf 'pre-commit: %s is not on PATH; refusing rather than half-checking.\n' "$tool" >&2
    exit 1
done

# gitleaks matches a well-formed key structurally, not by prefix (Anthropic's
# rule keys on the trailing AA); these prefix-only rules add the malformed ones.
PATTERNS=(
    'ANTHROPIC_API_KEY|sk-ant-[A-Za-z0-9_-]{24,}'
    'OPENAI_API_KEY|sk-proj-[A-Za-z0-9_-]{24,}'
    'PRIVATE_KEY_BLOCK|-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'AWS_ACCESS_KEY_ID|(AKIA|ASIA|ABIA|ACCA)[A-Z0-9]{16}'
    'GITHUB_TOKEN|gh[pousr]_[A-Za-z0-9]{36}'
    'SLACK_TOKEN|xox[abprs]-[A-Za-z0-9-]{12,}'
    'GOOGLE_API_KEY|AIza[0-9A-Za-z_-]{35}'
    'STRIPE_KEY|[sr]k_(live|test)_[A-Za-z0-9]{16,}'
    'SECRET_ASSIGNMENT|^[[:space:]]*(export[[:space:]]+)?['\''"]?[A-Z0-9_]*(SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_KEY|ACCESS_KEY)[A-Z0-9_]*['\''"]?[[:space:]]*[=:][[:space:]]*.?[A-Za-z0-9+/_=-]{20,}'
)

ENV_KEY='(_(KEY|SECRET|TOKEN|PASSWORD|PASS|PWD|CREDENTIALS|CREDENTIAL|SALT|SIGNATURE|DSN|CERT)$)|(PASSWORD|PASSWD|SECRET|TOKEN|PRIVATE|CREDENTIAL|SIGNATURE|SALT|DSN|CERT|API_?KEY)'

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD

if ! staged=$(git diff --cached --no-color --diff-filter=ACMRT --unified=0 2>/dev/null); then
    printf 'pre-commit: cannot read the staged changes; refusing the commit.\n' >&2
    exit 1
fi

if ! added=$(printf '%s\n' "$staged" | awk '
    /^\+\+\+ b\// { path = substr($0, 7); next }
    /^\+\+\+ /    { path = "(unknown file)"; next }
    /^\+/         { if (path != "") print path "\t" substr($0, 2) }
'); then
    printf 'pre-commit: cannot parse the staged diff; refusing the commit.\n' >&2
    exit 1
fi

fail=0
declare -A hits=()

if command -v gitleaks >/dev/null 2>&1; then
    if ! report=$(gitleaks git --staged --redact -v 2>&1); then
        found=$(printf '%s\n' "$report" | grep -E '^(RuleID|File|Line):' | head -30) || found=
        if [ -n "$found" ]; then
            printf 'pre-commit: gitleaks found credential-shaped content in the staged diff:\n%s\n' "$found" >&2
        else
            printf 'pre-commit: gitleaks did not complete; refusing rather than half-checking.\n' >&2
        fi
        fail=1
    fi
fi

for rule in "${PATTERNS[@]}"; do
    line=$(printf '%s\n' "$added" | cut -f2- | grep -E -n -m1 -e "${rule#*|}" | cut -d: -f1) || true
    [ -n "$line" ] && hits["${rule%%|*}"]=$(printf '%s\n' "$added" | sed -n "${line}p" | cut -f1)
done

env_file=$root/.env
if [ ! -f "$env_file" ]; then
    if common=$(git rev-parse --git-common-dir 2>/dev/null) && common=$(cd "$common" 2>/dev/null && pwd -P); then
        env_file=${common%/*}/.env
    fi
fi

if [ ! -r "$env_file" ]; then
    printf 'pre-commit: cannot read this repository'\''s .env (looked for %s);\n' "$env_file" >&2
    printf 'refusing rather than half-checking. Start one with: cp .env.example .env\n' >&2
    exit 1
fi

names=()
values=()

remember() {
    [ ${#2} -ge 8 ] && names+=("$1") && values+=("$2")
    return 0
}

while IFS= read -r line || [ -n "$line" ]; do
    line=${line%$'\r'}
    line=${line#export }
    case "$line" in \#*|'') continue ;; esac
    case "$line" in *=*) ;; *) continue ;; esac
    name=${line%%=*}
    value=${line#*=}
    case "$value" in
        '"'*'"') value=${value#\"}; value=${value%\"} ;;
        "'"*"'") value=${value#\'}; value=${value%\'} ;;
    esac
    case "$value" in
        *://*:*@*)
            userinfo=${value#*://}
            userinfo=${userinfo%%@*}
            remember "$name (embedded password)" "${userinfo#*:}"
            ;;
    esac
    printf '%s' "$name" | grep -qE "$ENV_KEY" && remember "$name" "$value"
done < "$env_file"

if [ ${#values[@]} -gt 0 ]; then
    while IFS=$'\t' read -r path content; do
        [ -n "$content" ] || continue
        for i in "${!values[@]}"; do
            [[ $content == *"${values[$i]}"* ]] && hits["${names[$i]}"]=$path
        done
    done <<< "$added"
fi

# Names the key and the file, never the value: an echoed secret is in a
# scrollback and a log the moment the guard catches it (S2).
if [ ${#hits[@]} -gt 0 ]; then
    {
        printf 'pre-commit: refusing this commit — a secret is staged.\n'
        for key in "${!hits[@]}"; do
            printf '  %s found in %s\n' "$key" "${hits[$key]}"
        done
    } >&2
    fail=1
fi

[ $fail -eq 0 ] || printf 'Unstage it and put the value in .env. Deliberate override: git commit --no-verify.\n' >&2
exit $fail
