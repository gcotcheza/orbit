*.log
.DS_Store
# deptrac writes it unless --no-cache; untracked, it lands in what the gate's
# secrets step scans (scripts/check.sh lists with --others).
.deptrac.cache
.env
.env.backup
# The E2E sandbox's whole identity: its own APP_KEY, its own database password
# and the login the browser types. Generated by scripts/e2e.sh on first run and
# regenerated with --fresh-env — a committed one would be a shared credential in
# git, which is what generating it avoids.
.env.e2e
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
# What a browser run produces: full-page screenshots, the HTML report, traces
# and the saved session. Regenerated on every `scripts/e2e.sh`, and megabytes of
# it. The COMMITTED reference images are e2e/baselines/, which is not this.
/e2e/artifacts
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
