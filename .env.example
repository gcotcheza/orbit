APP_NAME=Orbit
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://flights.ghiecode.io

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The display and scheduling timezone: which calendar day a fare counts toward,
# what "leaving Friday" means in a rule, and when the Sunday digest goes out.
# Laravel itself stays on UTC and every timestamp is stored in UTC — this is
# separate on purpose, so a traveller in another zone changes one line.
ORBIT_TIMEZONE=Europe/Amsterdam

# Which fare adapters to use. `fake` is a deterministic simulation of European
# short-haul pricing, and is what PRODUCTION runs until the provider keys exist
# (docs/PLAN.md) — not a test double. Swapping in the real ones is these two
# lines and nothing else: no call site names an adapter. An unknown name throws
# at resolution rather than falling back, because a box quietly serving invented
# prices would send real alerts about fares that do not exist.
#
# PRICE: `fake` or `travelpayouts`. The real one needs TRAVELPAYOUTS_TOKEN below
# and throws at resolution without it — see the note there before flipping this,
# because the day you do, the history in the database stops meaning one thing.
#
# STATS: `fake` or `self`. There is no third option and there will not be one —
# the plan was Amadeus' price-analysis endpoint and their Self-Service API was
# decommissioned on 2026-07-17. `self` computes a route's usual price from
# Orbit's own two tables: the current calendar window from the first poll
# onwards, blended toward the accruing daily history as that matures (a month of
# polling, `selfstats` in config/orbit.php). It needs no key and no network.
#
# ⚠ SET IT IN THE SAME BREATH AS ORBIT_PRICE_PROVIDER, not before. `self` is a
#   summary of whatever fares are in the database, so pointing it at a table the
#   FAKE provider filled produces a real statistic about a simulation. Flip both,
#   then `php artisan orbit:reset-history --confirm`, then
#   `php artisan orbit:refresh-stats --now`.
ORBIT_PRICE_PROVIDER=fake
ORBIT_STATS_PROVIDER=fake

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres 18 — service name on the compose network, no host port published.
# NB: this file doubles as docker compose's env file, so DB_* is read by both
# Laravel and the postgres container. KEEP THE PASSWORD ALPHANUMERIC: compose
# would try to interpolate a `$` in it, and the app and the database would then
# disagree about what the password is.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=orbit
DB_USERNAME=orbit
DB_PASSWORD=

# Sessions in Postgres rather than Redis: one user, and a session that survives
# a redis flush is worth more than the microseconds.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The app is HTTPS-only behind Cloudflare + host nginx, so the session cookie
# has no business travelling over plain http. `lax` keeps the login redirect
# working while blocking cross-site POSTs.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum is in cookie/session mode — no tokens, nothing in localStorage. This
# is the list of hosts whose requests are treated as first-party, i.e. get the
# session instead of being read as an anonymous token call. Sanctum would
# already derive this host from APP_URL; it is written out because a list that
# is derived is a list nobody checks.
SANCTUM_STATEFUL_DOMAINS=flights.ghiecode.io

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Fare polling, scoring and alert delivery all run on the queue; the `horizon`
# compose service is the worker.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis

# Redis holds the queue and the cache and is reachable from every container on
# the compose bridge network, so it wants a password of its own. This value is
# read TWICE: by Laravel, and by the `redis` service in docker-compose.yml,
# which passes it to `--requirepass`. That is what keeps the two in step.
#
# EMPTY (or the literal `null`) MEANS NO PASSWORD, in both places — the compose
# service special-cases both, because Laravel's env() reads `null` as PHP null
# and compose would otherwise set the four characters n-u-l-l as the password.
#
# To rotate it: change the value, then restart redis AND app/horizon/scheduler
# TOGETHER — redis starts demanding the new password the moment it is recreated,
# and a php-fpm still holding the old config answers every request with NOAUTH.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=
REDIS_PORT=6379

# `log` until ghiecode.io is verified as a sending domain in Resend. Alerts are
# written to storage/logs until then, which is a deliberate stage: it lets the
# alert-firing rules be tuned against real fares before anything is delivered.
MAIL_MAILER=log

# WHERE THAT LOG IS, and it is not the application log. The log transport writes
# at DEBUG; LOG_LEVEL above is `info`, so without this every staged alert was
# rendered and then dropped by the default channel's own floor — the stage had
# nothing on it and nothing said so. `mail` is a channel of its own
# (config/logging.php) at debug level, writing to storage/logs/mail.log.
# It costs nothing once Resend is configured: an SMTP mailer never touches it.
MAIL_LOG_CHANNEL=mail
MAIL_FROM_ADDRESS="flights@ghiecode.io"
MAIL_FROM_NAME="Orbit"

# The single account, created by the seeder. Leave SEED_USER_PASSWORD unset and
# the seeder GENERATES a strong password and prints it once; set it only to
# deliberately rotate.
SEED_USER_EMAIL=ghie.cotcheza@gmail.com
SEED_USER_NAME=Ghie
SEED_USER_PASSWORD=

# Horizon dashboard access outside `local`. EMPTY MEANS DENY — an unset secret
# is never read as "no secret required". Leave unset in production: the host
# vhost 404s /horizon regardless, and this only unlocks a tunnelled look at
# 127.0.0.1:3085. Generate with: openssl rand -hex 32
HORIZON_DASHBOARD_TOKEN=

# --- Fare providers ---------------------------------------------------------
# NONE OF THESE ARE REQUIRED TO RUN THE APP. Until they carry values the
# config-selected Fake providers serve realistic seeded fares, which is what
# makes every screen buildable and demoable before a single signup.
# Never commit a real value: this file is the template, values live in .env.

# Travelpayouts (affiliate) — one-way fares per departure date, from
# /v2/prices/month-matrix. Set this AND ORBIT_PRICE_PROVIDER=travelpayouts
# above; either alone does nothing useful, and the provider without the token
# refuses to resolve rather than serving an empty calendar.
#
# ⚠ THE SWITCH IS NOT REVERSIBLE IN THE DATA. Every fare, observation and
#   statistic already in the database came from the simulation, and a real price
#   written into the same table is indistinguishable from a fake one afterwards
#   — which makes the 30-day trend, the "usually €120" and the next alert all
#   quietly wrong. Run `php artisan orbit:reset-history --confirm` at the same
#   time. It drops the three observation tables and re-polls; the watchlist,
#   rules, settings and alert ledger are untouched. Charts then say "tracking 1
#   day", which is honest, and fill in from there.
#
# ⚠ COVERAGE IS PATCHY AND THAT IS NORMAL. These are cached fares from other
#   people's searches, so a route has a price on 40-90% of the next 90 days and
#   the calendar has real gaps in it. A day with no fare is absent, not €0.
# TRAVELPAYOUTS_TOKEN=

# The affiliate marker — read by config/orbit.php and sent to nobody. The data
# API does not want it; it identifies whose link a BOOKING came from, and
# Orbit's book buttons are Skyscanner deep links. Fill it in when that changes.
# TRAVELPAYOUTS_MARKER=

# NO KEYS FOR THE STATISTICS. The route price *statistics* the deal score is a
# percentile against ("what this route usually costs") were going to be
# Amadeus'; their Self-Service API was decommissioned on 2026-07-17 and nothing
# else sells the distribution of a route's fares. ORBIT_STATS_PROVIDER=self
# computes them from the fares Orbit has already fetched. Nothing to sign up for.

# Anthropic — parses "cheap weekend somewhere sunny under €80" into a rule.
# There is a regex fallback for when this is unset or the call fails, so the
# create-rule screen never hard-depends on it. Wants its own key, not a
# borrowed one from another app on this box.
# ANTHROPIC_API_KEY=
